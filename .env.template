# Node & Environment
NODE_ENV=production
PORT=6001
SESSION_SECRET=<random-secret-string-for-express-session>
FORCE_HTTPS=true

# IBM App ID Configuration
APPID_CLIENT_ID=<appid-client-id>
APPID_TENANT_ID=<appid-tenant-id>
APPID_SECRET=<appid-secret>
APPID_PROFILES_URL=<appid-profiles-url>
APPID_OAUTH_SERVER_URL=<appid-oauth-server-url>
APPID_REDIRECT_URI=https://<your-app-domain>

# IBM Cloud Code Engine (Optional if APPID_REDIRECT_URI is provided)
CE_APP=<code-engine-app-name>
CE_SUBDOMAIN=<code-engine-subdomain>
CE_DOMAIN=<code-engine-domain>

# Db2 Configuration
DB2_DATABASE=<DB2.DATABASE>
DB2_HOSTNAME=<DB2.HOSTNAME>
DB2_USERNAME=<DB2.USERNAME>
DB2_PASSWORD=<DB2.PWD>
DB2_PORT=<DB2.PORT>
DB2_SCHEMA=<DB2.SCHEMA>